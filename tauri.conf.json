{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalan",
  "version": "1.0.0",
  "identifier": "com.linedesign.kalan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kalan",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© LineDesign",
    "category": "Finance",
    "shortDescription": "Kişisel finans takibi",
    "longDescription": "Kalan — ne geldi, ne gitti, ne kaldı? Çevrimdışı, gizliliğe saygılı kişisel finans uygulaması. Verileriniz yalnızca cihazınızda saklanır."
  }
}
