{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Kalan masaüstü uygulaması için varsayılan izinler",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "fs:default",
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "$DOCUMENT" }, { "path": "$DOCUMENT/**" }] },
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "$DOCUMENT" }, { "path": "$DOCUMENT/**" }] },
    { "identifier": "fs:allow-mkdir", "allow": [{ "path": "$DOCUMENT" }, { "path": "$DOCUMENT/**" }] },
    { "identifier": "fs:allow-read-dir", "allow": [{ "path": "$DOCUMENT" }, { "path": "$DOCUMENT/**" }] },
    { "identifier": "fs:allow-remove", "allow": [{ "path": "$DOCUMENT" }, { "path": "$DOCUMENT/**" }] },
    { "identifier": "fs:allow-exists", "allow": [{ "path": "$DOCUMENT" }, { "path": "$DOCUMENT/**" }] }
  ]
}
